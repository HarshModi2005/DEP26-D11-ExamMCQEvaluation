# Optional: For accessing private Drive folders
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DRIVE_FOLDER_ID=your_drive_folder_id

# ---- Result cache backend ----
# "sqlite" (default, local dev) | "supabase" (deployment)
CACHE_BACKEND=sqlite

# Required when CACHE_BACKEND=supabase.
# Use the POOLED Postgres URL from Supabase → Project Settings → Database.
# Example (port 6543 with sslmode=require):
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=

# Optional asyncpg pool tuning
SUPABASE_POOL_MIN=1
SUPABASE_POOL_MAX=10
